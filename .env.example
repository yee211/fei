# 复制为 .env 并填入你的 key（.env 已被 .gitignore 排除）
FEI_API_KEY=sk-xxx

# OpenAI 兼容端点，换成你的供应商：
#   智谱     https://open.bigmodel.cn/api/paas/v4   模型 glm-4.6
#   DeepSeek https://api.deepseek.com               模型 deepseek-flash
FEI_BASE_URL=https://api.deepseek.com
FEI_MODEL=deepseek-flash

# 工具的相对路径基准目录，默认当前目录
FEI_WORKDIR=.
# 单个任务最多工具调用轮数（防死循环）
FEI_MAX_TURNS=30
# 每次请求前的上下文预算；API usage + 保守估算，预留模型响应空间
FEI_COMPACT_TOKENS=48000
# 是否流式输出（1 开 / 0 关）
FEI_STREAM=1
# 设为 1 关闭危险命令硬拦截（默认开启）
# FEI_ALLOW_DANGEROUS=1
# 设为 1 在控制台显示完整工具调用过程（默认只显示最终回答与错误）
# FEI_VERBOSE=1
# 强制指定 bash 路径（默认自动探测 Git Bash：注册表/git 推导/PATH，排除 WSL 的 bash）
# FEI_BASH=D:\utils\Git\bin\bash.exe

# 单次模型请求超时（秒）；临时连接错误、408/409/429/5xx 有限重试
FEI_REQUEST_TIMEOUT=60
FEI_REQUEST_RETRIES=2
